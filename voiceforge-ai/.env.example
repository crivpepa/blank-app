# ─────────────────────────────────────────────────────────────
# VoiceForge AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────

# ElevenLabs API credentials
# Get your key at: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# (Optional) Pre-existing voice ID to skip the cloning step.
# Leave blank if you plan to upload samples and create a new voice.
ELEVENLABS_VOICE_ID=

# Local paths
SAMPLES_DIR=./samples
EXPORTS_DIR=./exports

# TTS audio model — options: eleven_monolingual_v1 | eleven_multilingual_v2
TTS_MODEL_ID=eleven_multilingual_v2

# Express server port (local web UI)
PORT=3000
