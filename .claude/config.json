{
  "version": "1.0",
  "name": "blank-app",
  "description": "A blank Streamlit application configured for Claude Code",
  "language": "python",
  "settings": {
    "codeStyle": "pep8",
    "pythonVersion": "3.8+",
    "linter": "pylint",
    "formatter": "black",
    "typeChecker": "mypy"
  },
  "directories": {
    "source": ".",
    "tests": "tests",
    "docs": "docs"
  },
  "excludePatterns": [
    "__pycache__",
    "*.pyc",
    ".venv",
    "venv",
    ".git",
    ".pytest_cache",
    "*.egg-info"
  ],
  "capabilities": {
    "codeAnalysis": true,
    "codeGeneration": true,
    "debugging": true,
    "testing": true,
    "documentation": true
  }
}
